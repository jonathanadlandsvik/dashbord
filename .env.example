# Kopier til .env og fyll inn. .env skal aldri committes.
# I produksjon settes de samme verdiene i Vercel under Settings -> Environment Variables.

# --- App ---
APP_ENV=development                 # development | production
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=                     # python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database (Neon) ---
# Lim inn strengene akkurat slik Neon viser dem (postgresql://...).
# Lokalt: strengene for dev-branchen. I Vercel: strengene for production-branchen.
DATABASE_URL=                       # pooled: vertsnavnet inneholder -pooler. Brukes av appen.
DATABASE_URL_UNPOOLED=              # direkte: uten -pooler. Brukes bare til migrasjoner (Alembic).

# --- Innlogging (passkeys) ---
WEBAUTHN_RP_ID=localhost            # domenet appen kjører på, uten https://
WEBAUTHN_ORIGIN=http://localhost:8000
SETUP_TOKEN=                        # engangstoken for første passkey-registrering, fjernes etterpå

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Vær og bysykkel ---
YR_USER_AGENT=dashbord/2.0 github.com/jonathanadlandsvik/dashbord
VAER_LAT=63.4305
VAER_LON=10.3951
BYSYKKEL_STASJON_ID=293
